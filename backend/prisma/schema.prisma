generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash")
  role          String         @db.VarChar(20)
  fullName      String         @map("full_name") @db.VarChar(150)
  phoneNumber   String?        @map("phone_number") @db.VarChar(20)
  avatarUrl     String?        @map("avatar_url")
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  client        Client?
  driver        Driver?
  fleetManager  FleetManager?
  notifications Notification[]

  @@map("users")
}

model Client {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  clientCode       String            @unique @map("client_code") @db.VarChar(50)
  companyName      String            @map("company_name") @db.VarChar(150)
  billingAddress   String?           @map("billing_address")
  contactPerson    String?           @map("contact_person") @db.VarChar(150)
  contactPhone     String?           @map("contact_phone") @db.VarChar(20)
  industry         String?           @db.VarChar(100)
  createdAt        DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clients_user")
  deliveries       Delivery[]
  deliveryRequests DeliveryRequest[]

  @@map("clients")
}

model FleetManager {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @unique @map("user_id") @db.Uuid
  employeeCode     String          @unique @map("employee_code") @db.VarChar(50)
  depotLocation    String?         @map("depot_location")
  shiftDetails     String?         @map("shift_details") @db.VarChar(100)
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  deliveries       Delivery[]
  reviewedConcerns DriverConcern[]
  managedDrivers   Driver[]        @relation("ManagerToDrivers")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fleet_managers_user")

  @@map("fleet_managers")
}

model Driver {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                   @unique @map("user_id") @db.Uuid
  employeeCode          String                   @unique @map("employee_code") @db.VarChar(50)
  reportingManagerId    String?                  @map("reporting_manager_id") @db.Uuid
  status                String                   @default("available") @db.VarChar(20)
  score                 Decimal?                 @db.Decimal(5, 2)
  riskLevel             String?                  @map("risk_level") @db.VarChar(20)
  safetyGrade           String?                  @map("safety_grade") @db.Char(1)
  licenseNumber         String?                  @unique @map("license_number") @db.VarChar(100)
  licenseExpiry         DateTime?                @map("license_expiry") @db.Date
  contractType          String?                  @map("contract_type") @db.VarChar(50)
  shiftWindow           String?                  @map("shift_window") @db.VarChar(100)
  assignedDepot         String?                  @map("assigned_depot")
  emergencyContactName  String?                  @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?                  @map("emergency_contact_phone") @db.VarChar(20)
  address               String?
  totalTripsCompleted   Int                      @default(0) @map("total_trips_completed")
  rating                Decimal?                 @db.Decimal(3, 2)
  createdAt             DateTime?                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  aiRecommendations     AiDriverRecommendation[]
  completedTrips        CompletedTrip[]
  deliveries            Delivery[]
  coachingGoals         DriverCoachingGoal[]
  concerns              DriverConcern[]
  dailyScores           DriverDailyScore[]
  schedules             DriverSchedule[]
  reportingManager      FleetManager?            @relation("ManagerToDrivers", fields: [reportingManagerId], references: [id], onUpdate: NoAction, map: "fk_drivers_manager")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_drivers_user")
  vehicleAssignments    VehicleAssignment[]

  @@map("drivers")
}

model Vehicle {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationNumber String              @unique @map("registration_number") @db.VarChar(50)
  makeModel          String              @map("make_model") @db.VarChar(150)
  vehicleType        String              @map("vehicle_type") @db.VarChar(50)
  capacityKg         Decimal?            @map("capacity_kg") @db.Decimal(10, 2)
  fuelType           String?             @map("fuel_type") @db.VarChar(50)
  status             String              @default("active") @db.VarChar(30)
  telematicsDeviceId String?             @unique @map("telematics_device_id") @db.VarChar(100)
  createdAt          DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  completedTrips     CompletedTrip[]
  deliveries         Delivery[]
  vehicleAssignments VehicleAssignment[]

  @@map("vehicles")
}

model VehicleAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  unassignedAt    DateTime? @map("unassigned_at") @db.Timestamp(6)
  assignmentNotes String?   @map("assignment_notes")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  driver          Driver    @relation(fields: [driverId], references: [id], onUpdate: NoAction, map: "fk_vehicle_assignments_driver")
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onUpdate: NoAction, map: "fk_vehicle_assignments_vehicle")

  @@map("vehicle_assignments")
}

model DeliveryRequest {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestCode          String                   @unique @map("request_code") @db.VarChar(50)
  clientId             String                   @map("client_id") @db.Uuid
  pickupAddress        String                   @map("pickup_address")
  dropAddress          String                   @map("drop_address")
  packageCategory      String?                  @map("package_category") @db.VarChar(100)
  weightKg             Decimal?                 @map("weight_kg") @db.Decimal(10, 2)
  lengthCm             Decimal?                 @map("length_cm") @db.Decimal(10, 2)
  widthCm              Decimal?                 @map("width_cm") @db.Decimal(10, 2)
  heightCm             Decimal?                 @map("height_cm") @db.Decimal(10, 2)
  handleWithCare       Boolean                  @default(false) @map("handle_with_care")
  priority             String                   @default("normal") @db.VarChar(20)
  dateMode             String                   @default("flexible") @map("date_mode") @db.VarChar(20)
  preferredDate        DateTime?                @map("preferred_date") @db.Date
  preferredTimeWindow  String?                  @map("preferred_time_window") @db.VarChar(100)
  specialInstructions  String?                  @map("special_instructions")
  estimatedCost        Decimal?                 @map("estimated_cost") @db.Decimal(12, 2)
  estimatedTransitTime String?                  @map("estimated_transit_time") @db.VarChar(100)
  status               String                   @default("pending") @db.VarChar(30)
  createdAt            DateTime?                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  aiRecommendations    AiDriverRecommendation[]
  delivery             Delivery?
  client               Client                   @relation(fields: [clientId], references: [id], onUpdate: NoAction, map: "fk_delivery_requests_client")

  @@index([clientId], map: "idx_delivery_requests_client_id")
  @@map("delivery_requests")
}

model Delivery {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryCode         String                 @unique @map("delivery_code") @db.VarChar(50)
  requestId            String                 @unique @map("request_id") @db.Uuid
  clientId             String                 @map("client_id") @db.Uuid
  managerId            String?                @map("manager_id") @db.Uuid
  driverId             String?                @map("driver_id") @db.Uuid
  vehicleId            String?                @map("vehicle_id") @db.Uuid
  status               String                 @default("unassigned") @db.VarChar(30)
  priority             String?                @db.VarChar(20)
  pickupLocation       String                 @map("pickup_location")
  dropLocation         String                 @map("drop_location")
  expectedDeliveryTime DateTime?              @map("expected_delivery_time") @db.Timestamp(6)
  actualDeliveryTime   DateTime?              @map("actual_delivery_time") @db.Timestamp(6)
  amount               Decimal?               @db.Decimal(12, 2)
  paymentMethod        String?                @map("payment_method") @db.VarChar(50)
  paymentStatus        String                 @default("pending") @map("payment_status") @db.VarChar(30)
  hasConcern           Boolean                @default(false) @map("has_concern")
  specialInstructions  String?                @map("special_instructions")
  handlingRequirements String?                @map("handling_requirements")
  deliveryNotes        String?                @map("delivery_notes")
  additionalDetails    String?                @map("additional_details")
  driverNotes          String?                @map("driver_notes")
  managerNotes         String?                @map("manager_notes")
  podSignatureUrl      String?                @map("pod_signature_url")
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  completedTrip        CompletedTrip?
  client               Client                 @relation(fields: [clientId], references: [id], onUpdate: NoAction, map: "fk_deliveries_client")
  driver               Driver?                @relation(fields: [driverId], references: [id], onUpdate: NoAction, map: "fk_deliveries_driver")
  manager              FleetManager?          @relation(fields: [managerId], references: [id], onUpdate: NoAction, map: "fk_deliveries_manager")
  request              DeliveryRequest        @relation(fields: [requestId], references: [id], onUpdate: NoAction, map: "fk_deliveries_request")
  vehicle              Vehicle?               @relation(fields: [vehicleId], references: [id], onUpdate: NoAction, map: "fk_deliveries_vehicle")
  trackingSteps        DeliveryTrackingStep[]
  concerns             DriverConcern[]
  scheduleStops        DriverScheduleStop[]

  @@index([driverId], map: "idx_deliveries_driver_id")
  @@index([vehicleId], map: "idx_deliveries_vehicle_id")
  @@map("deliveries")
}

model DeliveryTrackingStep {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId     String    @map("delivery_id") @db.Uuid
  stageName      String    @map("stage_name") @db.VarChar(50)
  completedAt    DateTime? @map("completed_at") @db.Timestamp(6)
  isCompleted    Boolean   @default(false) @map("is_completed")
  isAutoDetected Boolean   @default(false) @map("is_auto_detected")
  sequence       Int
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  delivery       Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tracking_steps_delivery")

  @@unique([deliveryId, sequence], map: "unique_delivery_sequence")
  @@unique([deliveryId, stageName], map: "unique_delivery_stage")
  @@map("delivery_tracking_steps")
}

model DriverSchedule {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId       String               @map("driver_id") @db.Uuid
  scheduleDate   DateTime             @map("schedule_date") @db.Date
  shiftStartTime DateTime?            @map("shift_start_time") @db.Time(6)
  shiftEndTime   DateTime?            @map("shift_end_time") @db.Time(6)
  depotLocation  String?              @map("depot_location")
  createdAt      DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  stops          DriverScheduleStop[]
  driver         Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_driver_schedules_driver")

  @@unique([driverId, scheduleDate], map: "unique_driver_schedule")
  @@map("driver_schedules")
}

model DriverScheduleStop {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId  String         @map("schedule_id") @db.Uuid
  deliveryId  String?        @map("delivery_id") @db.Uuid
  sequence    Int
  timeLabel   String?        @map("time_label") @db.VarChar(100)
  stopTitle   String         @map("stop_title") @db.VarChar(150)
  stopType    String         @map("stop_type") @db.VarChar(30)
  city        String?        @db.VarChar(100)
  isCompleted Boolean        @default(false) @map("is_completed")
  completedAt DateTime?      @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  delivery    Delivery?      @relation(fields: [deliveryId], references: [id], onUpdate: NoAction, map: "fk_schedule_stops_delivery")
  schedule    DriverSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_schedule_stops_schedule")

  @@unique([scheduleId, sequence], map: "unique_schedule_stop_sequence")
  @@map("driver_schedule_stops")
}

model CompletedTrip {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripCode                 String          @unique @map("trip_code") @db.VarChar(50)
  deliveryId               String          @unique @map("delivery_id") @db.Uuid
  driverId                 String          @map("driver_id") @db.Uuid
  vehicleId                String          @map("vehicle_id") @db.Uuid
  completionDate           DateTime        @map("completion_date") @db.Date
  startTime                DateTime        @map("start_time") @db.Timestamp(6)
  endTime                  DateTime        @map("end_time") @db.Timestamp(6)
  durationMinutes          Int?            @map("duration_minutes")
  distanceKm               Decimal?        @map("distance_km") @db.Decimal(10, 2)
  drivingScore             Decimal?        @map("driving_score") @db.Decimal(5, 2)
  hasIncident              Boolean         @default(false) @map("has_incident")
  incidentDetail           String?         @map("incident_detail")
  aiOverallSummary         String?         @map("ai_overall_summary")
  aiBrakingSummary         String?         @map("ai_braking_summary")
  aiAccelerationSummary    String?         @map("ai_acceleration_summary")
  aiRouteEfficiencySummary String?         @map("ai_route_efficiency_summary")
  createdAt                DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  delivery                 Delivery        @relation(fields: [deliveryId], references: [id], onUpdate: NoAction, map: "fk_completed_trips_delivery")
  driver                   Driver          @relation(fields: [driverId], references: [id], onUpdate: NoAction, map: "fk_completed_trips_driver")
  vehicle                  Vehicle         @relation(fields: [vehicleId], references: [id], onUpdate: NoAction, map: "fk_completed_trips_vehicle")
  concerns                 DriverConcern[]
  tripEvents               TripEvent[]

  @@index([driverId], map: "idx_completed_trips_driver_id")
  @@map("completed_trips")
}

model TripEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId         String        @map("trip_id") @db.Uuid
  eventTimestamp DateTime      @map("event_timestamp") @db.Timestamp(6)
  eventType      String        @map("event_type") @db.VarChar(50)
  location       String?
  severity       String        @default("info") @db.VarChar(20)
  description    String?
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  trip           CompletedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trip_events_trip")

  @@index([tripId], map: "idx_trip_events_trip_id")
  @@map("trip_events")
}

model DriverDailyScore {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId               String    @map("driver_id") @db.Uuid
  scoreDate              DateTime  @map("score_date") @db.Date
  overallScore           Decimal   @map("overall_score") @db.Decimal(5, 2)
  riskLevel              String    @map("risk_level") @db.VarChar(20)
  safetyGrade            String    @map("safety_grade") @db.Char(1)
  smoothDrivingScore     Decimal?  @map("smooth_driving_score") @db.Decimal(5, 2)
  harshBrakingScore      Decimal?  @map("harsh_braking_score") @db.Decimal(5, 2)
  speedingScore          Decimal?  @map("speeding_score") @db.Decimal(5, 2)
  rapidAccelerationScore Decimal?  @map("rapid_acceleration_score") @db.Decimal(5, 2)
  corneringScore         Decimal?  @map("cornering_score") @db.Decimal(5, 2)
  nightDriveScore        Decimal?  @map("night_drive_score") @db.Decimal(5, 2)
  deliveriesCompleted    Int       @default(0) @map("deliveries_completed")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  driver                 Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_driver_daily_scores_driver")

  @@unique([driverId, scoreDate], map: "unique_driver_daily_score")
  @@map("driver_daily_scores")
}

model DriverCoachingGoal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  goalTitle       String    @map("goal_title") @db.VarChar(200)
  targetMetric    String?   @map("target_metric") @db.VarChar(100)
  timeframe       String?   @db.VarChar(100)
  progressPercent Decimal   @default(0) @map("progress_percent") @db.Decimal(5, 2)
  practicalTip    String?   @map("practical_tip")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_driver_coaching_goals_driver")

  @@map("driver_coaching_goals")
}

model DriverConcern {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concernCode          String         @unique @map("concern_code") @db.VarChar(50)
  driverId             String         @map("driver_id") @db.Uuid
  deliveryId           String?        @map("delivery_id") @db.Uuid
  tripId               String?        @map("trip_id") @db.Uuid
  category             String         @db.VarChar(50)
  systemEventType      String?        @map("system_event_type") @db.VarChar(50)
  systemEventTimestamp DateTime?      @map("system_event_timestamp") @db.Timestamp(6)
  systemEventLocation  String?        @map("system_event_location")
  systemEventDetails   String?        @map("system_event_details")
  contextReason        String?        @map("context_reason") @db.VarChar(50)
  driverDescription    String         @map("driver_description")
  status               String         @default("pending_review") @db.VarChar(30)
  managerReviewNotes   String?        @map("manager_review_notes")
  reviewedByManagerId  String?        @map("reviewed_by_manager_id") @db.Uuid
  submittedAt          DateTime       @default(now()) @map("submitted_at") @db.Timestamp(6)
  reviewedAt           DateTime?      @map("reviewed_at") @db.Timestamp(6)
  delivery             Delivery?      @relation(fields: [deliveryId], references: [id], onUpdate: NoAction, map: "fk_driver_concerns_delivery")
  driver               Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_driver_concerns_driver")
  reviewedByManager    FleetManager?  @relation(fields: [reviewedByManagerId], references: [id], onUpdate: NoAction, map: "fk_driver_concerns_manager")
  trip                 CompletedTrip? @relation(fields: [tripId], references: [id], onUpdate: NoAction, map: "fk_driver_concerns_trip")

  @@map("driver_concerns")
}

model AiDriverRecommendation {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId          String          @map("request_id") @db.Uuid
  driverId           String          @map("driver_id") @db.Uuid
  matchScore         Decimal         @map("match_score") @db.Decimal(5, 2)
  suitabilityReasons Json?           @map("suitability_reasons")
  isBestMatch        Boolean         @default(false) @map("is_best_match")
  createdAt          DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  driver             Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_recommendations_driver")
  request            DeliveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_recommendations_request")

  @@unique([requestId, driverId], map: "unique_ai_recommendation")
  @@map("ai_driver_recommendations")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(200)
  body      String
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}
